# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://inboxguard:inboxguard@localhost:5434/inboxguard

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Gmail OAuth (read-only). Used in a later milestone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Telegram bot. Used in a later milestone.
TELEGRAM_BOT_TOKEN=

# LLM — required for classification. Switch providers by changing these vars only.
# LLM_PROVIDER: openai_compatible | anthropic
LLM_PROVIDER=openai_compatible
# LLM_KEY can be empty for local Ollama; any placeholder string also works there.
LLM_KEY=
# Required. Examples: gpt-4o-mini, llama-3.1-8b-instant, llama3.1, claude-haiku-4-5
LLM_MODEL=
# Only used when LLM_PROVIDER=openai_compatible. Examples:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama      http://localhost:11434/v1   (LLM_KEY can be any string)
LLM_BASE_URL=https://api.openai.com/v1
# Set false for providers that reject response_format={"type":"json_object"}
LLM_JSON_MODE=true
# OpenAI-compatible only. Appends /no_think to the user message (Qwen3 and similar).
LLM_DISABLE_THINKING=false
LLM_MAX_TOKENS=300
LLM_TIMEOUT_S=30
# Optional USD per million tokens, used only to estimate cost
# LLM_PRICE_INPUT_PER_M=0.15
# LLM_PRICE_OUTPUT_PER_M=0.60

# App
DEFAULT_TIMEZONE=Asia/Kolkata
